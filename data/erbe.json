// Was ein Verlieren dauerhaft bringt. Siehe src/prestige.h/.cpp.
//
// Beim Verlieren gibt es Erbe-Punkte (siehe "punkte_*" unten), die einen
// Neuanfang ueberleben. Damit kauft man Stufen in den Upgrades hier - jede
// bleibt fuer immer, auch nach "Start over".
//
// Im Spiel stehen nie alle Upgrades gleichzeitig da: "angebote" sagt, wie
// viele zufaellige davon gerade zur Auswahl stehen. Neu gewuerfelt wird nur
// bei einer Niederlage - solange man spielt, bleiben die Angebote stehen.
{
    "angebote": 3,

    // Punkte = punkte_basis * Rundennummer^punkte_exponent
    //        + Geld beim Verlieren / punkte_geld_teiler
    "punkte_basis":       15,
    "punkte_exponent":    1.3,
    "punkte_geld_teiler": 800,

    "upgrades": [
        { "schluessel": "geld_prozent", "name": "Geld pro Block",   "einheit": "%", "basis": 25,  "wachstum": 1.15, "wirkung": 1.0, "maximum": 0  },
        { "schluessel": "rundenzeit",   "name": "Rundenzeit",       "einheit": "s", "basis": 30,  "wachstum": 1.14, "wirkung": 8.0, "maximum": 0  },
        { "schluessel": "nachwachsen",  "name": "Nachwachsen",      "einheit": "%", "basis": 40,  "wachstum": 1.18, "wirkung": 3.0, "maximum": 15 },
        { "schluessel": "tempo",        "name": "Tempo",            "einheit": "%", "basis": 50,  "wachstum": 1.20, "wirkung": 2.0, "maximum": 20 },
        { "schluessel": "startgeld",    "name": "Startkapital",     "einheit": "",  "basis": 20,  "wachstum": 1.10, "wirkung": 25,  "maximum": 0  },
        { "schluessel": "ofen",         "name": "Extra-Ofen",       "einheit": "",  "basis": 250, "wachstum": 1.6,  "wirkung": 1,   "maximum": 3  },
        { "schluessel": "konsole",      "name": "Extra-Konsole",    "einheit": "",  "basis": 400, "wachstum": 1.8,  "wirkung": 1,   "maximum": 2  },
        { "schluessel": "forschung",    "name": "Forschungsrabatt", "einheit": "%", "basis": 45,  "wachstum": 1.15, "wirkung": 4.0, "maximum": 10 },
        { "schluessel": "ziel_rabatt",  "name": "Mietnachlass",     "einheit": "%", "basis": 90,  "wachstum": 1.35, "wirkung": 1.0, "maximum": 8  }
    ]
}
