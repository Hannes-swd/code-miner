
{
  "level": { "art": "bloecke", "pro_level": 20 },

  // Behandlung beim Abbau. Je wertvoller ein Erz, desto WAHRSCHEINLICHER will
  // es gekuehlt oder erhitzt werden. Gewuerfelt wird das aber nur einmal, wenn
  // es das Erz zum ersten Mal gibt - danach steht es fest: Gold will immer
  // dasselbe, jeder einzelne Goldblock.
  //
  // Deshalb sagt einem im Programm niemand, was zu tun ist. Man muss wissen,
  // welches Erz was will (es steht im Wiki), und danach fragen, welches gerade
  // dasteht: if (block.is(Gold)) block.mine(Cool);
  //
  // Die Zahlen hier gelten fuer alle Erze, auch fuer die gewuerfelten aus
  // data/erzgenerator.json:
  //
  //   ab_wert         bis zu diesem Grundwert verlangt ein Erz nie etwas
  //   chance_max      hoechste Wahrscheinlichkeit, die dabei herauskommt
  //   wert_halb       bei "ab_wert + wert_halb" ist die Haelfte davon erreicht
  //   verlust_ohne    wie viele Punkte Reinheit es kostet, wenn man nichts tut
  //   verlust_falsch  ... und wenn man das Falsche tut
  //
  // Bei jedem Erz unten darf "behandlung" stehen: "keine", "cool" oder "heat".
  // Fehlt der Eintrag, wird aus Name und Wert gewuerfelt - fuer denselben Namen
  // kommt dabei immer dasselbe heraus.
  //
  // Die Zeit bleibt gleich: ein falsch abgebauter Block kommt genauso schnell
  // heraus, er ist nur weniger wert. Reinheit wirkt linear von 0.5x (0 %) bis
  // 1.5x (100 %) auf den Preis - siehe data/verarbeitung.json.
  "behandlung": {
    "ab_wert": 8,
    "chance_max": 0.8,
    "wert_halb": 45,
    "verlust_ohne": 25,
    "verlust_falsch": 50
  },

